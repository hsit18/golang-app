HTTP_PORT=<CUSTOM_HTTP_PORT>
MUX_HTTP_PORT=<MUX_HTTP_PORT>

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=golang-app-producer

# Kafka Consumer Configuration
KAFKA_CONSUMER_GROUP_ID=golang-app-consumer-group
KAFKA_CONSUMER_TOPICS=test-topic,user-events,logs

# Optional: For secured Kafka clusters (leave empty for local development)
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=